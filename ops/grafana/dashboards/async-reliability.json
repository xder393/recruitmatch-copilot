{
  "uid": "async-reliability",
  "title": "Async Reliability",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "recruitmatch",
    "cp5"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "Reading this dashboard",
      "options": {
        "mode": "markdown",
        "content": "Completed means committed publication. Failed counts committed failed attempts; retry is an overlapping scheduled-retry subset. Never sum failed + retry as exclusive outcomes. Queue authority is PostgreSQL. Aggregate gauges select the latest fresh Beat writer; absent values are unknown."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Committed publications / second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_type,deployment_environment_name) (rate(recruitmatch_task_completed_total[$__rate_interval]))",
          "legendFormat": "{{source_type}} {{operation}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Failed owned attempts / second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_type,deployment_environment_name) (rate(recruitmatch_task_failed_total[$__rate_interval]))",
          "legendFormat": "{{source_type}} {{operation}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no data"
        },
        "overrides": []
