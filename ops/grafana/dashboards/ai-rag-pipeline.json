{
  "uid": "ai-rag-pipeline",
  "title": "AI & RAG Pipeline",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "recruitmatch",
    "cp5"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "Reading this dashboard",
      "options": {
        "mode": "markdown",
        "content": "Provider requests count physical attempts, including retries. Fallback counts logical degradation decisions; it is not system downtime. Disabled AI is not a failed provider. Embedding has batch/query spans in Tempo, no invented embedding metric. Unrecognized optional model.name values are removed by Collector; defaults deepseek-chat and BAAI/bge-small-zh-v1.5 are retained."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Physical model attempts / second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_provider,model_name,outcome,deployment_environment_name) (rate(recruitmatch_model_request_total[$__rate_interval]))",
          "legendFormat": "{{source_type}} {{operation}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Physical model attempt P95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,deployment_environment_name) (rate(recruitmatch_model_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{source_type}} {{operation}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Model tokens / second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment_environment_name) (rate(recruitmatch_model_tokens_total[$__rate_interval]))",
          "legendFormat": "{{source_type}} {{operation}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
