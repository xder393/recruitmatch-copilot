        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,deployment_environment_name) (rate(recruitmatch_vector_search_duration_seconds_bucket[$__rate_interval])))",
