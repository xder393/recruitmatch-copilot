    },
    {
      "type": "table",
      "title": "Embedding batch/query traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"embedding.generate\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 36,
