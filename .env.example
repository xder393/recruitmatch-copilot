# ===== LLM（兼容 OpenAI 格式的 API：DeepSeek / 通义 / Ollama 等）=====
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ===== Embedding（本地模型，首次运行自动下载 ~95MB）=====
OPENAI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内网络下载失败时，可设置镜像：
# HF_ENDPOINT=https://hf-mirror.com

# ===== 存储路径 =====
DATA_DIR=data
INDEX_DIR=data/index
CONVERSATIONS_FILE=data/conversations.json

# ===== RecruitMatch 数据库与认证 =====
DATABASE_URL=postgresql+psycopg://recruitmatch:recruitmatch@postgres:5432/recruitmatch
# 生产环境必须替换为至少 32 字节的随机值
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_MINUTES=30

# ===== RAG 参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# ===== Agent =====
LLM_TEMPERATURE=0.2
MAX_AGENT_ITERATIONS=3
