# ===== LLM（兼容 OpenAI 格式的 API：DeepSeek / 通义 / Ollama 等）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ===== Embedding（本地模型，首次运行自动下载 ~95MB）=====
OPENAI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内网络下载失败时，可设置镜像：
# HF_ENDPOINT=https://hf-mirror.com

# ===== RecruitMatch 数据库与认证 =====
# 本机直接运行的默认值；Docker Compose 会在容器内覆盖为 PostgreSQL
DATABASE_URL=sqlite:///data/recruitmatch.db
# 生产环境必须替换为至少 32 字节的随机值
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_MINUTES=30
ARTIFACT_DIR=data/resumes
KNOWLEDGE_ARTIFACT_DIR=data/knowledge
# 本机默认内联执行；Docker Compose 会覆盖为 celery + redis
TASK_MODE=inline
CELERY_BROKER_URL=redis://localhost:6379/0

# ===== RecruitMatch AI（无 Key 时保持 false，规则模式仍可用） =====
AI_ENABLED=false
MODEL_PROVIDER=openai-compatible
LLM_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_RETRIES=1
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
RESUME_PROMPT_VERSION=resume-extract-v1
EXPLANATION_PROMPT_VERSION=match-explanation-v1
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.35
MAX_EVIDENCE_CHARACTERS=8000
